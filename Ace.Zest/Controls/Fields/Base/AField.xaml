<c:ContentControl
	x:Class="Ace.Controls.AField"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cnv="clr-namespace:Ace.Markup.Converters"
	xmlns:c="clr-namespace:Ace.Controls"
	xmlns:m="clr-namespace:Ace.Markup"
	ToolTipService.ShowDuration="60000"
	x:Name="This"
	>
	<Control.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../../../Dictionaries/AppConverters.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<cnv:Converter
				x:Key="FormatConverter"
				Convert="FormatConverter_Convert"
				ConvertBack="FormatConverter_ConvertBack"
				/>
			<cnv:Converter
				x:Key="ToolTipConverter"
				Convert="ToolTipConverter_Convert"
				/>
			<Style
				TargetType="c:Title"
				>
				<Setter Property="Margin" Value="5 0" />
				<Setter Property="FontFamily" Value="Consolas" />
				<Setter Property="HorizontalAlignment" Value="Right" />
			</Style>
			<Style
				TargetType="RepeatButton"
				>
				<Setter Property="Margin" Value="0" />
				<Setter Property="FontSize" Value="7" />
				<Setter Property="Foreground" Value="DimGray" />
				<Setter Property="IsEnabled" Value="{Binding IsReadOnly, Converter={StaticResource TrueToFalseConverter}}" />
			</Style>
		</ResourceDictionary>
	</Control.Resources>

	<Control.ToolTip>
		<ToolTip
			Name="ValueToolTip"
			DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
			IsOpen="{Binding (Validation.HasError), Source={x:Reference ValueField}, Mode=OneWay}"
			>
			<c:Stack>
				<GroupBox
					DataContext="{x:Reference ValueField}"
					Visibility="{Binding (Validation.HasError), Converter={StaticResource FalseToCollapsedConverter}}"
					>
					<GroupBox.Header>
						<c:Title
							Background="Firebrick"
							Foreground="White"
							FontWeight="Bold"
							Text="{m:Localizing Error}"
							/>
					</GroupBox.Header>
					<StackPanel
						MaxWidth="256"
						Orientation="Vertical"
						>
						<c:Stack
							c:Children.ItemsSource="{Binding (Validation.Errors)}"
							>
							<c:Children.ItemTemplate>
								<DataTemplate>
									<TextBlock
										TextWrapping="Wrap"
										Text="{Binding ErrorContent}"
										/>
								</DataTemplate>
							</c:Children.ItemTemplate>
						</c:Stack>
					</StackPanel>
				</GroupBox>
				<GroupBox>
					<GroupBox.Header>
						<c:Stack
							Orientation="Horizontal"
							>
							<c:Title
								c:Rack.Cell="R4 C0"
								FontWeight="Bold"
								Text="{m:Localizing Value}"
								/>
							<c:Title
								c:Rack.Cell="R4 C5"
								FontWeight="Bold"
								Text="{Binding Value}"
								/>
						</c:Stack>
					</GroupBox.Header>
					<c:Rack
						Rows="^ ^"
						Columns="* ^"
						>
						<c:Title
							c:Rack.Cell="R0 C0"
							Text="{m:Localizing Step, StringFormat='▲ {0}'}"
							/>
						<c:Title
							c:Rack.Cell="R1 C0"
							Text="{m:Localizing Step, StringFormat='▼ {0}'}"
							/>

						<c:Title
							c:Rack.Cell="R0 C3"
							Text="{Binding Step, StringFormat='+{0}'}"
							/>
						<c:Title
							c:Rack.Cell="R1 C4"
							Text="{Binding Step, StringFormat='-{0}'}"
							/>
					</c:Rack>
				</GroupBox>
				<GroupBox>
					<GroupBox.Header>
						<c:Stack
							Orientation="Horizontal"
							>
							<c:Title
								c:Rack.Cell="R4 C0"
								FontWeight="Bold"
								Text="{m:Localizing Length}"
								/>
							<c:Title
								c:Rack.Cell="R4 C5"
								FontWeight="Bold"
								Text="{Binding Length}"
								/>
						</c:Stack>
					</GroupBox.Header>
					<c:Rack
						Rows="^ ^"
						Columns="* ^"
						>
						<c:Title
							c:Rack.Cell="R0 C0"
							Text="{m:Localizing From}"
							/>
						<c:Title
							c:Rack.Cell="R1 C0"
							Text="{m:Localizing Till}"
							/>

						<c:Title
							c:Rack.Cell="R0 C3"
							Text="{Binding From}"
							/>
						<c:Title
							c:Rack.Cell="R1 C4"
							Text="{Binding Till}"
							/>
					</c:Rack>
				</GroupBox>
			</c:Stack>
		</ToolTip>
	</Control.ToolTip>

	<c:Rack
		Columns="^ *"
		DataContext="{m:Reference This}"
		>
		<c:Rack
			c:Rack.Cell="C0"
			Rows="* *"
			Margin="0 0 -1 0"
			Visibility="{Binding IsKeyboardFocusWithin, Converter={StaticResource TrueToVisibleConverter}}"
			PreviewGotKeyboardFocus="Skip_PreviewGotKeyboardFocus"
			>
			<RepeatButton
				c:Rack.Cell="R0"
				Click="TillButton_Click"
				Content="▲"
				/>
			<RepeatButton
				c:Rack.Cell="R1"
				Click="FromButton_Click"
				Content="▼"
				/>
		</c:Rack>

		<c:Field
			c:Rack.Cell="C1"
			x:Name="ValueField"
			Margin="0"
			BorderThickness="1"
			IsReadOnlyCaretVisible="True"
			IsReadOnly="{Binding IsReadOnly}"
			SelectionChanged="ValueField_SelectionChanged"
			PreviewKeyDown="ValueField_PreviewKeyDown"
			PreviewMouseWheel="ValueField_PreviewMouseWheel"
			LostFocus="ValueField_LostFocus"
			GotFocus="ValueField_GotFocus"
			>
			<c:Field.Text>
				<Binding
					Path="Value"
					Mode="TwoWay"
					Converter="{StaticResource FormatConverter}"
					UpdateSourceTrigger="PropertyChanged"
					>
					<Binding.ValidationRules>
						<m:CustomRule
							ValidationStep="RawProposedValue"
							Validation="CustomRule_Validation"
							/>
					</Binding.ValidationRules>
				</Binding>
			</c:Field.Text>
		</c:Field>
	</c:Rack>
</c:ContentControl>
