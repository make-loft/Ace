<c:Rack
	x:Class="Ace.Controls.NumericField"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cnv="clr-namespace:Ace.Markup.Converters"
	xmlns:c="clr-namespace:Ace.Controls"
	xmlns:m="clr-namespace:Ace.Markup"
	x:Name="This"
	Columns="^ *"
	Rows="* *"
	>
	<c:Rack.Resources>
		<cnv:Converter
			x:Key="FormatConverter"
			Convert="FormatConverter_Convert"
			ConvertBack="FormatConverter_ConvertBack"
			/>
	</c:Rack.Resources>
	<RepeatButton
		c:Rack.Cell="R0 C0"
		x:Name="TillButton"
		Margin="0 0 -1 0"
		FontSize="7"
		Content="▲"
		DataContext="{m:Reference This}"
		IsEnabled="{Binding IsReadOnly, Converter={StaticResource TrueToFalseConverter}}"
		Visibility="{Binding IsKeyboardFocusWithin, Converter={StaticResource TrueToVisibleConverter}}"
		PreviewGotKeyboardFocus="Skip_PreviewGotKeyboardFocus"
		Click="TillButton_Click"
		/>
	<RepeatButton
		c:Rack.Cell="R1 C0"
		x:Name="FromButton"
		Margin="0 0 -1 0"
		FontSize="7"
		Content="▼"
		DataContext="{m:Reference This}"
		IsEnabled="{Binding IsReadOnly, Converter={StaticResource TrueToFalseConverter}}"
		Visibility="{Binding IsKeyboardFocusWithin, Converter={StaticResource TrueToVisibleConverter}}"
		PreviewGotKeyboardFocus="Skip_PreviewGotKeyboardFocus"
		Click="FromButton_Click"
		/>
	<c:Field
		c:Rack.Cell="R0 RS2 C1"
		x:Name="ValueField"
		Margin="0"
		BorderThickness="1"
		IsReadOnlyCaretVisible="True"
		ToolTip="{Binding Value, ElementName=This}"
		Text="{Binding Value, ElementName=This, Mode=TwoWay, Converter={StaticResource FormatConverter}}"
		PreviewKeyDown="ValueField_PreviewKeyDown"
		GotFocus="ValueField_GotFocus"
		/>
</c:Rack>
